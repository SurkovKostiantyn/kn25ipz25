// backend example:
// create_user.php через PDO
<?php
$name = $_POST['name'];
$email = $_POST['email'];
$password = $_POST['password'];

$sql = "INSERT INTO Users (name, email, password) VALUES ('$name', '$email', '$password')";

// PDO
$conn = new PDO("mysql:host=localhost;dbname=users", "root", "");
$stmt = $conn->prepare($sql);
$stmt->execute();

// Це у нас UPDATE (PATCH, PUT - це для редагування)

// edit user.php через PDO
$name = $_POST['name'];
$email = $_POST['email'];
$password = $_POST['password'];

$sql = "UPDATE Users SET name = '$name', email = '$email', password = '$password' WHERE id = 1";

// PDO
$conn = new PDO("mysql:host=localhost;dbname=users", "root", "");
$stmt = $conn->prepare($sql);
$stmt->execute();